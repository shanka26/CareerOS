# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Supabase Postgres (recommended hosted backend)
# Copy both URLs from Supabase Dashboard > Connect > ORMs > Prisma.
# Use transaction mode (port 6543) for serverless runtime traffic and a direct
# connection (port 5432) for migrations. URL-encode special password characters.
DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require
DIRECT_URL=postgresql://postgres:URL_ENCODED_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require

# Local PostgreSQL alternative:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/careeros
# DIRECT_URL=postgresql://postgres:postgres@localhost:5432/careeros
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/careeros_test
SEED_DEMO_DATA=false
SEED_USER_EMAIL=demo@careeros.example

# Better Auth (generate a strong value; never commit it)
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OpenAI (AI features fail closed when omitted)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# Optional job-search providers. Arbeitnow Germany and UK work without keys.
# Register each application and accept its provider terms before enabling it.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=us
USAJOBS_API_KEY=
USAJOBS_USER_AGENT=
THE_MUSE_API_KEY=

# Private Vercel Blob storage (production). Vercel injects this when a Blob
# store is connected to the project. Local development uses .data/uploads.
BLOB_READ_WRITE_TOKEN=
