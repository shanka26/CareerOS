# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# PostgreSQL (required). The defaults target the optional local Docker service.
# For Supabase, copy the two connection strings from the dashboard's Connect panel:
# - DATABASE_URL: transaction pooler (port 6543) for serverless deployments, adding
#   `?pgbouncer=true&connection_limit=1` (or `&...` when the URL already has a query).
# - DIRECT_URL: direct connection, or the session pooler (port 5432) on IPv4-only networks.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/careeros
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/careeros
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/careeros_test
SEED_DEMO_DATA=false
SEED_USER_EMAIL=demo@careeros.example

# Better Auth (generate a strong value; never commit it)
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OpenAI (AI features fail closed when omitted)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# Object storage; local is development-only. S3 values are reserved for the pending production adapter.
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
