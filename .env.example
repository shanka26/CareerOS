# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# PostgreSQL (required for database-backed features from Milestone 3 onward)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/careeros
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/careeros
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/careeros_test
SEED_DEMO_DATA=false
SEED_USER_EMAIL=demo@careeros.example

# Better Auth (generate a strong value; never commit it)
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OpenAI (AI features fail closed when omitted)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Object storage; local is development-only
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=.data/uploads
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
